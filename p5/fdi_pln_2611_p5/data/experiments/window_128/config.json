{
  "seed": 42,
  "corpus": {
    "data_dir": "data/corpus",
    "extra_data_dir": "data/corpus/extra",
    "extra_max_books": 4
  },
  "tokenizer": {
    "vocab_size": 300,
    "show_progress": false,
    "use_cache": true,
    "cache_path": "data/bpe_tokenizer.json",
    "train_tokens_cache_path": "data/train_tokens.json",
    "test_tokens_cache_path": "data/test_tokens.json"
  },
  "model": {
    "d_model": 128,
    "n_blocks": 4,
    "n_heads": 4,
    "window_size": 128,
    "dropout": 0.1
  },
  "training": {
    "epochs": 10,
    "batch_size": 64,
    "learning_rate": 0.0003
  },
  "grid_search": {
    "learning_rates": [
      0.0001,
      0.0003,
      0.001
    ],
    "batch_sizes": [
      32,
      64,
      128
    ],
    "epochs_per_run": 3,
    "results_path": "data/grid_search_results.json"
  },
  "experiment_exploration": {
    "epochs_per_run": 5,
    "results_path": "data/experiment_results.json",
    "report_path": "data/informe_experimentos.html",
    "cache_root": "data/experiments"
  },
  "ner_training": {
    "epochs": 15,
    "batch_size": 16,
    "learning_rate": 0.0003,
    "val_ratio": 0.2,
    "class_weight_mode": "inverse",
    "entity_class_weight_boost": 5.0,
    "loss": "ce",
    "focal_gamma": 1.5,
    "label_smoothing": 0.0,
    "best_metric": "macro_f1_non_o",
    "min_overall_acc": 0.8,
    "oversample_entity_windows": 2,
    "entity_prob_threshold": 0.5,
    "tune_entity_threshold": true,
    "val_eval_per_sentence": true,
    "train_window_stride": 1,
    "val_window_stride": 128,
    "backbone_lr_factor": 0.1
  },
  "checkpoint": {
    "path": "checkpoints/llm_checkpoint.pt",
    "save_every_epochs": 5,
    "save_at_end": true,
    "resume_if_exists": true
  },
  "epoch_output": {
    "path": "checkpoints/epoch_outputs.json"
  },
  "metrics": {
    "loss_csv_path": "checkpoints/losses.csv",
    "causal_history_csv_path": "checkpoints/causal_history.csv",
    "ner_history_csv_path": "checkpoints/ner_history.csv",
    "ner_report_path": "checkpoints/ner_report.html"
  },
  "generation": {
    "prompt": "Alice",
    "max_new_tokens": 100,
    "temperature": 1.0
  }
}